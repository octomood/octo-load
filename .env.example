# ---------------------------------------------------------------------------
# OctoLoad configuration
# Copy this file to .env and fill in BOT_TOKEN.
# ---------------------------------------------------------------------------

# Get it from @BotFather in Telegram.
BOT_TOKEN=

# Optional: your numeric Telegram id(s), comma separated. Enables /stats.
# Find your id with /id in the bot.
ADMIN_IDS=

# Telegram cloud Bot API allows 50 MB per bot upload. Do not raise this
# unless you run a local Bot API server (see README / DEPLOY).
UPLOAD_LIMIT_MB=50

# How many downloads run at the same time (global / per user).
MAX_CONCURRENT=3
PER_USER_CONCURRENT=1

# How many link submissions one user may make per hour.
RATE_LIMIT_PER_HOUR=20

# Max photos per album (Telegram hard limit is 10).
MAX_PHOTOS=10

# Max video height. Lower it to 720 on weak/free hosts.
MAX_HEIGHT=1080

# Where temporary files are stored.
WORK_DIR=./data

# Optional: Netscape-format cookies.txt for private/age-restricted content.
# COOKIES_FILE=/opt/octo-load/secrets/cookies.txt

# Optional: outbound proxy for yt-dlp and gallery-dl.
# PROXY=socks5://127.0.0.1:1080

# Optional: local Bot API server (allows uploads up to 2 GB).
# API_SERVER=http://127.0.0.1:8081

# Optional: health endpoint port (Render/Koyeb need it; Docker sets 8080).
# PORT=8080

# Optional: public URL used for a 10-minute self-ping (keeps Render awake).
# On Render RENDER_EXTERNAL_URL is picked up automatically.
# SELF_URL=https://octo-load.onrender.com

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Optional extra yt-dlp arguments, e.g. --geo-bypass
# YTDLP_EXTRA_ARGS=
